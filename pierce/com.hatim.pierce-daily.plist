<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- install to ~/Library/LaunchAgents/com.hatim.pierce-daily.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hatim.pierce-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>$HOME/pierce/pierce-daily.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/pierce-daily.out</string>
  <key>StandardErrorPath</key><string>/tmp/pierce-daily.err</string>
</dict>
</plist>
